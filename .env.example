DATABASE_PATH=./data/convene.sqlite
# Optional locally. Required in Vercel Production/Preview; set it in Vercel only.
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:3000
# APP_ORIGIN is set at build time. Set the public HTTPS origin for deployment.
# Node 24.x required. Demo accounts are created by db:seed or the Vercel deployment build.
# For deployment: use HTTPS and a persistent local disk for SQLite.
